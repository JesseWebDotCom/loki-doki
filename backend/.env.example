OLLAMA_URL=http://localhost:11434
IMAGE_GEN_URL=http://localhost:8188
DATABASE_URL=../data/app.db

# ── Voice subsystem (Admin → Voice / app_settings override these) ──
# Kokoro TTS + Whisper STT are served by the bundled Bun voice-server sidecar
# (backend/scripts/voice-server.ts, spawned automatically once installed).
# Override only to point at a remote/custom voice-server.
VOICE_SERVER_URL=http://localhost:8091
# VOICE_SERVER_PORT=8091   # port the local voice-server binds (used when spawning)
# Generate with: openssl rand -hex 32
PIN_PEPPER_SECRET=replace_with_64_char_hex
# Web Push (VAPID). Optional — auto-generated on first use and stored in app_settings
# if unset. Only set these to pin a specific keypair (e.g. across a DB restore).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
PORT=3000
NODE_ENV=development

# Single model for all tasks (routing, extraction, dedup, chat responses)
# 24 GB Apple Silicon: llama3.1:8b Q4_K_M (~4.7 GB) — leaves ~11.8 GB free for FLUX Schnell
# 36 GB+: llama3.3:27b Q4_K_M (~16 GB)
# 48 GB+: llama3.3:70b Q4_K_M (~40 GB)
MODEL=llama3.1:8b

# Optional: dedicated model for T2 routing (tool selection + arg extraction).
# Smaller/faster than MODEL — cuts T2 latency without affecting chat quality.
# Recommended: granite4.1:3b (IBM, native tool calling, ~1.8s T2 avg)
# If unset, falls back to MODEL.
# ROUTER_MODEL=granite4.1:3b
