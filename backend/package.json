{
  "name": "loki-doki-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_ENV=development bun run --hot src/index.ts",
    "check:build": "bun build --target=bun src/index.ts --external 'chromium-bidi/*' --outdir=/tmp/loki-bunbuild-check",
    "start": "bun run src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "seed:demo": "bun run scripts/seed-demo.ts",
    "seed:demo:reset": "bun run scripts/seed-demo.ts --reset",
    "eval:router": "bun run scripts/eval/router-eval.ts",
    "eval:memory": "bun run scripts/eval/memory-eval.ts",
    "eval:chat": "bun run scripts/eval/chat-e2e.ts",
    "eval:companion": "bun run scripts/eval/companion-eval.ts",
    "eval:continuity": "bun run scripts/eval/continuity-eval.ts",
    "eval:wakeword": "bun run scripts/eval/wakeword-fa-eval.ts"
  },
  "dependencies": {
    "@dicebear/collection": "^9.4.2",
    "@dicebear/core": "^9.4.2",
    "@huggingface/transformers": "3.8.1",
    "@openzim/libzim": "^4.4.0",
    "chrono-node": "^2.9.1",
    "drizzle-orm": "^0.41.0",
    "duck-duck-scrape": "^2.2.7",
    "fflate": "^0.8.3",
    "geotiff": "^3.0.5",
    "google-sr": "^6.0.0",
    "hono": "^4.7.0",
    "ical.js": "^2.2.1",
    "imapflow": "^1.5.0",
    "kokoro-js": "^1.2.1",
    "metadata-filter": "^1.3.0",
    "mqtt": "^5.15.1",
    "music-metadata": "^11.13.0",
    "node-pty": "^1.1.0",
    "node-unrar-js": "^2.0.2",
    "nodemailer": "^9.0.3",
    "obscenity": "^0.4.6",
    "osm-pbf-parser": "^2.3.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "playwright": "^1.61.0",
    "sharp": "^0.34.5",
    "ssh2": "^1.17.0",
    "tsdav": "^2.3.1",
    "unpdf": "^1.6.2",
    "web-push": "^3.6.7",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/nodemailer": "^8.0.1",
    "@types/ssh2": "^1.15.5",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.30.0"
  }
}
