node_modules/
dist/
.DS_Store
*.local

# Runtime data — databases, downloaded models, binaries
data/

# onnxruntime-web WASM — copied from node_modules at build (predev/prebuild),
# regenerable, ~38 MB. See frontend/scripts/copy-ort.mjs.
frontend/public/ort/*.wasm
frontend/public/ort/*.mjs

# OpenMoji icon set — copied from the `openmoji` npm package at build
# (predev/prebuild), regenerable, ~20 MB. See frontend/scripts/copy-openmoji.mjs.
frontend/public/openmoji/

# Backend environment variables
backend/.env

# Local agent state
.claude/

# Build artifacts / caches (regenerated)
__pycache__/
*.pyc
*.tsbuildinfo
docs/.astro/

# Compiled TS output emitted next to source (backend runs the .ts directly under Bun;
# the .js twins are build artifacts — the repo tracks only .ts in src).
backend/src/**/*.js

# Local audit scratch
.audit-tmp/

# Dev server logs
backend/dev-server.log
frontend/dev-vite.log
*.log
