node_modules/
dist/
.DS_Store
*.local

# Runtime data — databases, downloaded models, binaries
data/

# onnxruntime-web WASM — copied from node_modules at build (predev/prebuild),
# regenerable, ~38 MB. See frontend/scripts/copy-ort.mjs.
frontend/public/ort/*.wasm
frontend/public/ort/*.mjs

# OpenMoji icon set — copied from the `openmoji` npm package at build
# (predev/prebuild), regenerable, ~20 MB. See frontend/scripts/copy-openmoji.mjs.
frontend/public/openmoji/

# alphaTab SMuFL font — copied from @coderline/alphatab at build (predev/prebuild),
# regenerable. See frontend/scripts/copy-alphatab.mjs.
frontend/public/alphatab/

# Backend environment variables
backend/.env

# Local agent state (but track project skills — .claude/skills is shared config)
.claude/*
!.claude/skills/

# Docs screenshot pipeline — demo session tokens + the owner's personal-term denylist
# must never be committed (see backend/scripts/seed-demo.ts / frontend/scripts/docs-screenshot.mjs)
frontend/scripts/.demo-sessions.json
.demo-denylist.txt

# Build artifacts / caches (regenerated)
__pycache__/
*.pyc
*.tsbuildinfo
docs/.astro/

# Compiled TS output emitted next to source (backend runs the .ts directly under Bun;
# the .js twins are build artifacts — the repo tracks only .ts in src).
backend/src/**/*.js

# Local audit scratch
.audit-tmp/

# Dev server logs
backend/dev-server.log
frontend/dev-vite.log
*.log

# Launcher stamp files — touched by run.sh/run.ps1 and by the in-app updater on
# every step it runs. Untracked-but-not-ignored, they made a successful update
# dirty the checkout and block the *next* update's working-tree check.
.loki-build-stamp
.loki-install-stamp
